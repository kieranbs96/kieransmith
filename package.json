{
  "name": "kieransmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write . && npm run format:code",
    "format:code": "eslint . --fix --max-warnings=0 && prettier-eslint --write --prettier-last \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.mjs\" \"*.ts\"",
    "format:check": "prettier --check .",
    "test:seo": "npm run build && node --test tests/seo.test.ts",
    "typecheck": "next typegen && node node_modules/typescript7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "motion": "^13.2.0",
    "next": "16.3.8",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "prettier-eslint-cli": "^9.2.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
